<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#e8e8e8"
    android:orientation="vertical">

    <com.view.MTextView
        android:id="@+id/slotName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"
        android:gravity="start|center_vertical"
        android:text=""
        android:textAlignment="textStart"
        android:textColor="@color/black"
        android:textSize="@dimen/txt_size_17"
        android:visibility="gone"
        app:customTypeFace="@string/system_medium" />


    <androidx.cardview.widget.CardView
        android:id="@+id/slotsArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"
        app:cardBackgroundColor="#e8e8e8">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/containViewSlotOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.view.MTextView
                            android:id="@+id/SlotDayNameTxtView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:layout_weight="1"
                            android:gravity="start|center_vertical"
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_17ssp"
                            app:customTypeFace="@string/system_semi_bold" />

                        <ImageView
                            android:id="@+id/iv_clearSlots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="5dp" />
                        <!-- android:src="@drawable/ic_clear_time_slots"-->
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/fromSLotArea"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:elevation="0dp"
                            app:cardCornerRadius="@dimen/_8sdp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:id="@+id/slotFromCalenderArea"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="@dimen/_8sdp">

                                <com.view.MTextView
                                    android:id="@+id/fromtimeSlotVTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center_vertical"
                                    android:layout_weight="1"
                                    android:text="00:00"
                                    android:textAlignment="viewStart"
                                    android:textColor="#242424"
                                    android:textSize="@dimen/_15ssp"
                                    app:customTypeFace="@string/system_medium" />


                                <ImageView
                                    android:layout_width="@dimen/_20sdp"
                                    android:layout_height="@dimen/_20sdp"
                                    android:layout_gravity="end|center_vertical"
                                    android:tint="@color/appThemeColor_1"
                                    app:srcCompat="@drawable/ic_calendar_timeslot" />
                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                        <com.view.MTextView
                            android:id="@+id/toTxtView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="@dimen/txt_size_16"
                            app:customTypeFace="@string/system_medium" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/toSLotArea"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:elevation="0dp"
                            app:cardCornerRadius="@dimen/_8sdp"
                            app:cardElevation="0dp">

                            <LinearLayout
                                android:id="@+id/slotToCalenderArea"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:padding="@dimen/_8sdp">

                                <com.view.MTextView
                                    android:id="@+id/totimeSlotVTxt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="start|center_vertical"
                                    android:layout_weight="1"
                                    android:text="00:00"
                                    android:textAlignment="viewStart"
                                    android:textColor="#242424"
                                    android:textSize="@dimen/_15ssp"
                                    app:customTypeFace="@string/system_medium" />


                                <ImageView
                                    android:layout_width="@dimen/_20sdp"
                                    android:layout_height="@dimen/_20sdp"
                                    android:layout_gravity="end|center_vertical"
                                    android:tint="@color/appThemeColor_1"
                                    app:srcCompat="@drawable/ic_calendar_timeslot" />
                            </LinearLayout>

                        </androidx.cardview.widget.CardView>


                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <com.view.MTextView
                android:id="@+id/tv_mandatory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_marginEnd="5dp"
                android:text="*"
                android:textColor="#FF0000"
                android:textSize="@dimen/txt_size_22"
                android:visibility="gone" />

        </RelativeLayout>


    </androidx.cardview.widget.CardView>
</LinearLayout>
