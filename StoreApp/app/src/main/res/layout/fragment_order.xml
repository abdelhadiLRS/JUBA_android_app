<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:animateLayoutChanges="true">

            <LinearLayout
                android:id="@+id/containerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/orderRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:animateLayoutChanges="false"
                    android:orientation="vertical"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_order_design" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loading_order_detail"
                style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_30sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/noOrderImg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_no_order" />

                <com.view.MTextView
                    android:id="@+id/noOrdersTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_23sdp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/text23Pro_Dark"
                    android:textSize="@dimen/_14ssp"
                    android:visibility="gone"
                    app:customTypeFace="@string/system_bold"
                    tools:text="No Orders Found"
                    tools:visibility="visible" />

                <com.view.MTextView
                    android:id="@+id/noOrdersMsgTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/textSub23Pro_gray"
                    android:textSize="@dimen/_12ssp"
                    android:visibility="gone"
                    app:customTypeFace="@string/system_regular"
                    tools:text="No Orders Found mess"
                    tools:visibility="visible" />
            </LinearLayout>

            <com.view.ErrorView
                android:id="@+id/errorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:visibility="gone"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/connectPrinterlayout"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:clickable="true"
                android:focusable="true">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center|bottom"
                    android:clickable="false"
                    android:gravity="center"
                    app:srcCompat="@drawable/ic_printer_copy" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/newOrderNotificationArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:background="@drawable/btn_type_1_rounded_corner_fill"
                android:orientation="horizontal"
                android:padding="@dimen/_7sdp"
                android:visibility="gone"
                tools:visibility="gone">

                <com.view.MTextView
                    android:id="@+id/newOrderArrivedTxtView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:textColor="@color/appThemeColor_TXT_1"
                    android:textSize="@dimen/_10ssp"
                    app:customTypeFace="@string/system_semi_bold"
                    tools:text="New Order Arrived" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/removeNewOrderNotificationAreaImgView"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center_vertical"
                    app:srcCompat="@drawable/ic_close_round" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/availabilityArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_minus1sdp"
            android:layout_marginEnd="@dimen/_minus1sdp"
            android:layout_marginBottom="@dimen/_minus5sdp"
            android:background="@drawable/cardview_background_with_line_white"
            android:orientation="horizontal">

            <com.view.MTextView
                android:id="@+id/acceptingOrdersTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_13sdp"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:textColor="@color/text23Pro_Dark"
                android:textDirection="locale"
                android:textSize="@dimen/_12ssp"
                app:customTypeFace="@string/system_bold"
                tools:text="Accepting Orders" />

            <com.kyleduo.switchbutton.SwitchButton
                android:id="@+id/onlineOfflineSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                app:kswBackColor="@color/Green"
                app:kswThumbColor="@color/white"
                app:kswThumbHeight="@dimen/_11sdp"
                app:kswThumbMargin="5dp"
                app:kswThumbRangeRatio="2.7"
                app:kswThumbWidth="@dimen/_11sdp" />
        </LinearLayout>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>