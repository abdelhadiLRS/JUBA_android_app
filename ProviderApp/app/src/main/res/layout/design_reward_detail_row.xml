<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_10sdp"
    android:paddingBottom="@dimen/_10sdp"
    android:paddingEnd="@dimen/_10sdp">

    <com.view.MTextView
        android:id="@+id/titleHTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"

        android:textAlignment="viewStart"
        android:textColor="#656565"
        android:textSize="@dimen/_12ssp"
        app:customTypeFace="@string/system_regular" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/completedView"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        app:srcCompat="@drawable/ic_correct"
        app:tint="@color/Green" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/incompletedView"
        android:layout_width="@dimen/_10sdp"
        android:layout_height="@dimen/_10sdp"
        android:layout_gravity="center"
        android:layout_marginEnd="@dimen/_5sdp"

        android:visibility="gone"
        app:srcCompat="@drawable/reward_cancel"
        app:tint="@color/red" />

    <com.view.MTextView
        android:id="@+id/titleVTxt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.35"

        android:textColor="#1c1c1c"
        android:textSize="@dimen/_12ssp"
        app:customTypeFace="@string/system_regular" />
</LinearLayout>