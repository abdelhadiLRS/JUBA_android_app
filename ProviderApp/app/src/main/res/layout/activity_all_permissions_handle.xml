<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/permisssionImg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_25sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginEnd="@dimen/_25sdp"
                    app:srcCompat="@drawable/ic_permission_all" />

                <com.view.MTextView
                    android:id="@+id/permissiontitleTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/permisssionImg"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="#333333"
                    android:textSize="@dimen/_14ssp"
                    app:customTypeFace="@string/system_bold" />

                <WebView
                    android:id="@+id/noteTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/permissiontitleTxt"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:includeFontPadding="false"
                    android:justificationMode="inter_word"
                    android:text=""
                    android:textAlignment="viewStart"
                    android:textColor="#838383"
                    android:textSize="@dimen/_11ssp"
                   />
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>


    <LinearLayout
        android:id="@+id/btnArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
      >

        <include

            android:id="@+id/btn_type2_location"

            layout="@layout/btn_type_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="0" />

    </LinearLayout>

</LinearLayout>